FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

ENV SHELL=/bin/bash \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    PYTHONIOENCODING=UTF_8 \
    TZ=Europe/Paris

# Step 1: Configure timezone and locales non-interactively
RUN apt-get update && apt-get install -y \
        locales \
        tzdata \
    && ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime \
    && echo "${TZ}" > /etc/timezone \
    && dpkg-reconfigure --frontend noninteractive tzdata \
    && locale-gen en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y \
        ca-certificates \
        software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa -y \
    && apt-get update && apt-get install -y \
        apt-file \
        apt-transport-https \
        apt-utils \
        binutils \
        bison \
        build-essential \
        bzip2 \
        chrpath \
        clang \
        cmake \
        coreutils \
        curl \
        cython3 \
        doxygen \
        dvipng \
        ffmpeg \
        fftw-dev \
        findutils \
        flex \
        freeglut3-dev \
        ftp \
        gdal-data \
        gettext \
        gfortran \
        git \
        graphviz \
        gzip \
        hdf5-tools \
        keychain \
        latex-cjk-all \
        libafterimage-dev \
        libbison-dev \
        libblas-dev \
        libboost-all-dev \
        libbz2-dev \
        libcgal-dev \
        libcgns-dev \
