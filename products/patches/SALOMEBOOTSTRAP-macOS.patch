+++ b/__RUN_SALOME__/LaunchingScripts/CMakeLists.txt
@@ -59,7 +59,15 @@ INSTALL(PROGRAMS ${SCRIPTS}
         DESTINATION ${RUN_SALOME_SCRIPTS})
 INSTALL(FILES ${CMAKE_CURRENT_BINARY_DIR}/.bashrc DESTINATION ${ABS_APPLI_PATH})
 
-IF( (NOT DEFINED $ENV{PYTHON_ROOT_DIR}) AND (NOT DEFINED $ENV{PYTHON_INSTALL_DIR}) AND (NOT DEFINED $ENV{PYTHONHOME}) )
+IF(APPLE)
+  # /usr/bin/python3 on macOS is the Xcode CLT shim, not the interpreter used
+  # to build SALOME: point to the Python found at configure time instead.
+  IF( (NOT DEFINED ENV{PYTHON_ROOT_DIR}) AND (NOT DEFINED ENV{PYTHON_INSTALL_DIR}) AND (NOT DEFINED ENV{PYTHONHOME}) )
+    INSTALL(CODE "
+    EXECUTE_PROCESS(COMMAND ln -sf ${PYTHON_EXECUTABLE} python WORKING_DIRECTORY \${CMAKE_INSTALL_PREFIX}/${RUN_SALOME_SCRIPTS} )
+    ")
+  ENDIF()
+ELSEIF( (NOT DEFINED $ENV{PYTHON_ROOT_DIR}) AND (NOT DEFINED $ENV{PYTHON_INSTALL_DIR}) AND (NOT DEFINED $ENV{PYTHONHOME}) )
   INSTALL(CODE "
   EXECUTE_PROCESS(COMMAND ln -s /usr/bin/python3 python WORKING_DIRECTORY ${CMAKE_INSTALL_PREFIX}/${RUN_SALOME_SCRIPTS} )
   ")
