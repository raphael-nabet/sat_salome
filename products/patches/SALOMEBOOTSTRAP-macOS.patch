 .../Basics/BasicsGenericDestructor.cxx        |  6 +--
 __RUN_SALOME__/Basics/Basics_Utils.cxx        |  2 +
 __RUN_SALOME__/KernelBasics/CMakeLists.txt    |  9 ++++-
 __RUN_SALOME__/KernelBasics/KernelBasis.i     |  2 +-
 __RUN_SALOME__/KernelBasics/Monitoring.cxx    |  6 +++
 .../LaunchingScripts/CMakeLists.txt           | 10 ++++-
 __RUN_SALOME__/LaunchingScripts/nameserver.py |  2 +-
 .../LaunchingScripts/runSalomeCommon.py       |  2 +-
 .../SALOMELocalTrace/BaseTraceCollector.cxx   | 10 +++--
 .../SALOMELocalTrace/BaseTraceCollector.hxx   | 37 +++++++++++++++++++
 .../SALOMELocalTrace/FileTraceCollector.cxx   |  6 +--
 .../SALOMELocalTrace/LocalTraceCollector.cxx  |  6 +--
 .../SALOMELocalTrace/Test/CMakeLists.txt      |  5 +++
 salome                                        |  3 +-
 15 files changed, 97 insertions(+), 21 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 760fab0..41650f9 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -16,7 +16,7 @@
 #
 # See http://www.salome-platform.org/ or email : webmaster.salome@opencascade.com
 #
-CMAKE_MINIMUM_REQUIRED(VERSION 3.0)
+CMAKE_MINIMUM_REQUIRED(VERSION 3.5)
 PROJECT(SalomeBootstrap)
 # upper case
 STRING(TOUPPER ${PROJECT_NAME} PROJECT_NAME_UC)
@@ -81,6 +81,16 @@ SET( BOOTSTRAP_INSTALL_CMAKE ${ABS_APPLI_PATH}/${SALOME_INSTALL_CMAKE} CACHE PAT
    "Install path: SALOME cmake files")
 SET( SALOME_BOOTSTRAP __SALOME_BOOTSTRAP__ )
 
+# macOS: libraries are referenced through @rpath. All bootstrap libraries and
+# the _KernelBasis Python module are installed in ${BOOTSTRAP_INSTALL_LIBS},
+# so @loader_path is enough to resolve them, without relying on
+# DYLD_LIBRARY_PATH (stripped by SIP when going through /usr/bin/env or /bin/sh).
+IF(APPLE)
+  SET(CMAKE_MACOSX_RPATH ON)
+  SET(CMAKE_INSTALL_RPATH "@loader_path")
+  SET(CMAKE_INSTALL_RPATH_USE_LINK_PATH TRUE)
+ENDIF()
+
 # For salome test
 SET(BOOTSTRAP_TEST_DIR ${SALOME_EXT_INSTALL}/${SALOME_INSTALL_BINS}/test/BOOTSTRAP)
 SET(BOOTSTRAP_TEST_LIB ${SALOME_EXT_INSTALL}/${SALOME_INSTALL_BINS}/test/BOOTSTRAP/lib)
