diff --git a/__RUN_SALOME__/KernelBasics/Monitoring.cxx b/__RUN_SALOME__/KernelBasics/Monitoring.cxx
index cd46136..44963bf 100644
--- a/__RUN_SALOME__/KernelBasics/Monitoring.cxx
+++ b/__RUN_SALOME__/KernelBasics/Monitoring.cxx
@@ -60,7 +60,13 @@ static long LaunchMonitoringLinux(const std::string& pyScriptToEvaluate)
   {
     execlp(PYTHON_EXEC,PYTHON_EXEC,pyScriptToEvaluate.c_str(),nullptr);
     char buff[1024];
+#ifdef __APPLE__
+    // XSI-compliant strerror_r (returns int) on macOS, GNU variant (returns char*) with glibc
+    strerror_r(errno, buff, sizeof(buff));
+    std::ostringstream oss; oss << "LaunchMonitoring : Error during exe : " << buff;
+#else
     std::ostringstream oss; oss << "LaunchMonitoring : Error during exe : " << strerror_r(errno, buff, sizeof(buff));
+#endif
     throw std::runtime_error( oss.str() );
   }
   else
diff --git a/__RUN_SALOME__/LaunchingScripts/CMakeLists.txt b/__RUN_SALOME__/LaunchingScripts/CMakeLists.txt
index 1fcaa9b..2b424cc 100644
