diff --git a/__RUN_SALOME__/KernelBasics/CMakeLists.txt b/__RUN_SALOME__/KernelBasics/CMakeLists.txt
index b45d72e..48e9352 100644
--- a/__RUN_SALOME__/KernelBasics/CMakeLists.txt
+++ b/__RUN_SALOME__/KernelBasics/CMakeLists.txt
@@ -55,7 +55,14 @@ IF(${MACHINE} STREQUAL WINDOWS)
 ENDIF(${MACHINE} STREQUAL WINDOWS)
 #set_target_properties(_KernelBasis PROPERTIES SWIG_USE_TARGET_INCLUDE_DIRECTORIES TRUE)
 
-SWIG_LINK_LIBRARIES(KernelBasis ${PYTHON_LIBRARIES} ${PLATFORM_LIBS} KERNELBasics SALOMEBasics)
+IF(APPLE)
+  # Python extension modules must not link libpython on macOS: symbols are
+  # resolved at import time against the running interpreter.
+  SWIG_LINK_LIBRARIES(KernelBasis ${PLATFORM_LIBS} KERNELBasics SALOMEBasics SALOMELog)
+  SET_PROPERTY(TARGET _KernelBasis APPEND_STRING PROPERTY LINK_FLAGS " -undefined dynamic_lookup")
+ELSE()
+  SWIG_LINK_LIBRARIES(KernelBasis ${PYTHON_LIBRARIES} ${PLATFORM_LIBS} KERNELBasics SALOMEBasics)
+ENDIF()
 install(TARGETS _KernelBasis DESTINATION ${BOOTSTRAP_INSTALL_LIBS})
 install(FILES ${KernelBasis_HEADERS} DESTINATION ${BOOTSTRAP_INSTALL_HEADERS})
 SALOME_INSTALL_SCRIPTS("${_swig_SCRIPTS}" ${BOOTSTRAP_INSTALL_LIBS}
