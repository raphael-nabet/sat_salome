@@ -36,13 +36,15 @@
 // Class attributes initialisation, for class method BaseTraceCollector::run
 
 BaseTraceCollector* BaseTraceCollector::_singleton = 0;
-#ifndef WIN32
-pthread_mutex_t BaseTraceCollector::_singletonMutex;
-#else
+// A zero-filled pthread_mutex_t is a valid unlocked mutex with glibc, but not
+// on macOS (the structure carries a signature): always use the initializer.
 pthread_mutex_t BaseTraceCollector::_singletonMutex =
   PTHREAD_MUTEX_INITIALIZER;
-#endif
+#ifdef __APPLE__
+dispatch_semaphore_t BaseTraceCollector::_sem = 0;
+#else
 sem_t BaseTraceCollector::_sem;
+#endif
